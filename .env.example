# Copy this file to .env and fill in your own values. .env is git-ignored;
# this file is committed so others know which keys to set.

# Supabase Dashboard -> Settings -> Data API -> Project URL (no /rest/v1/ suffix)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Dashboard -> Settings -> API Keys -> anon / public key.
# Never use the service_role key here: it bypasses all security.
SUPABASE_KEY=your-anon-key

# Port the API listens on
PORT=8000
